        <div class="slider-container" id="hero-slider">
            <!-- Slide 1 -->
            <div class="slide active">
                <div class="slide-bg" style="background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1553413077-190dd305871c?q=80&w=2000&auto=format&fit=crop');"></div>
                <div class="slide-content" style="z-index: 1;">
                    <h2 class="slide-subtitle">MASSIVE ENTERPRISE INVENTORY</h2>
                    <h1 class="slide-title">500,000+ Parts Ready to Ship</h1>
                    <p class="slide-desc">Servers, Storage, Networking & Components — Delivering worldwide from Saudi Arabia.</p>
                    <div class="slide-actions">
                        <button class="btn btn-primary">Browse Catalog</button>
                        <button class="btn btn-outline">Request a Quote</button>
                    </div>
                </div>
            </div>
            <!-- Slide 2 -->
            <div class="slide" style="background: #0B1120;">
                <div id="chartdiv" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; opacity: 0.65;"></div>
                <div class="slide-content" style="z-index: 1;">
                    <h2 class="slide-subtitle">SHIPPING ACROSS MENA, AFRICA & BEYOND</h2>
                    <h1 class="slide-title">Worldwide Delivery</h1>
                    <p class="slide-desc">Dispatch on In-Stock Items via DHL, FedEx & UPS globally.</p>
                    <div class="slide-actions">
                        <button class="btn btn-primary">Browse Catalog</button>
                        <button class="btn btn-outline">Request a Quote</button>
                    </div>
                </div>
            </div>
            <!-- Slide 3 (Interactive Real Image Overlay) -->
            <div class="slide">
                <!-- Real Photograph Background -->
                <div class="slide-bg" style="background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=2000&auto=format&fit=crop');"></div>
                
                <!-- Interactive SVG Overlay (Matches background cover scaling) -->
                <svg viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice" style="position: absolute; width: 100%; height: 100%; top: 0; left: 0; z-index: 1;">
                    <defs>
                        <style>
                            .real-image-shape {
                                fill: transparent;
                                stroke: transparent; /* Hidden until hovered */
                                stroke-width: 3;
                                transition: all 0.3s ease;
                                cursor: crosshair;
                                pointer-events: auto;
                            }
                            .real-image-shape:hover {
                                fill: rgba(168, 117, 255, 0.45); /* Purple highlight over real image */
                                stroke: rgba(168, 117, 255, 1);
                                filter: drop-shadow(0 0 10px rgba(168, 117, 255, 0.8));
                            }
                            .real-shape-label {
                                fill: transparent;
                                font-family: 'Segoe UI', system-ui, sans-serif;
                                font-size: 20px;
                                font-weight: 700;
                                letter-spacing: 2px;
                                pointer-events: none;
                                transition: all 0.3s ease;
                                text-anchor: middle;
                            }
                            .real-image-shape:hover + .real-shape-label {
                                fill: #ffffff;
                                text-shadow: 0 4px 12px rgba(0,0,0,0.9);
                            }
                        </style>
                    </defs>

                    <!-- Top Left Chip (Network Controller) -->
                    <polygon points="500,300 660,260 830,340 620,400" class="real-image-shape" />
                    <text x="640" y="340" class="real-shape-label">NETWORK CONTROLLER</text>

                    <!-- Center Huge Chip (Main Processor) -->
                    <polygon points="850,450 1070,400 1330,530 980,590" class="real-image-shape" />
                    <text x="1090" y="505" class="real-shape-label">MAIN PROCESSOR (CPU)</text>

                    <!-- Bottom Right Chip (Storage Chipset) -->
                    <polygon points="1100,720 1180,680 1450,800 1300,870" class="real-image-shape" />
                    <text x="1260" y="790" class="real-shape-label">STORAGE CHIPSET</text>
                </svg>

                <div class="slide-content" style="z-index: 2; pointer-events: none;">
                    <h2 class="slide-subtitle" style="pointer-events: auto;">ENTERPRISE COMPUTING</h2>
                    <h1 class="slide-title" style="pointer-events: auto;">Premium IT Hardware</h1>
                    <p class="slide-desc" style="pointer-events: auto;">Top quality motherboards, processors, and storage solutions for data centers.</p>
                    <div class="slide-actions" style="pointer-events: auto;">
                        <button class="btn btn-primary">Browse Catalog</button>
                        <button class="btn btn-outline">Request a Quote</button>
                    </div>
                </div>
            </div>

                    <a href="#" class="btn-signin"><i class="fa-regular fa-user"></i> Sign In</a>
                    <a href="#" class="btn-cart"><i class="fa-solid fa-cart-shopping"></i></a>
                </div>
            </div>

            <!-- Navigation Menu -->
            <nav class="main-nav">
                <ul class="nav-links">
                    <li class="has-dropdown"><a href="#">Products <i class="fa-solid fa-chevron-down"></i></a></li>
                    <li class="has-dropdown">
                        <a href="#">Solutions <i class="fa-solid fa-chevron-down"></i></a>
                        <ul class="dropdown-menu">
                            <li><a href="#"><span>Best Parts</span></a></li>
                            <li><a href="#"><span>Bulk Order</span></a></li>
                            <li><a href="#"><span>SpecsPro</span> <i class="fa-solid fa-chevron-right"></i></a></li>
                            <li><a href="#"><span>End of Life</span></a></li>
                            <li><a href="#"><span>AI & ML Servers</span></a></li>
                            <li><a href="#"><span>Database Servers</span></a></li>
                            <li><a href="#"><span>NAS & Storage</span></a></li>
                            <li><a href="#"><span>Virtualization</span></a></li>
                            <li><a href="#"><span>Email Servers</span></a></li>
                            <li><a href="#"><span>VDI Servers</span></a></li>
                        </ul>
                    </li>
                    <li class="has-dropdown"><a href="#">Data Center <i class="fa-solid fa-chevron-down"></i></a></li>
                    <li class="has-dropdown"><a href="#">Computing <i class="fa-solid fa-chevron-down"></i></a></li>
                    <li class="has-dropdown"><a href="#">Services <i class="fa-solid fa-chevron-down"></i></a></li>
                    <li><a href="#">Upgrade Guides</a></li>
